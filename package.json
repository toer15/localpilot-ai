{
  "name": "localpilot-ai",
  "version": "0.1.1",
  "description": "LocalPilot AI — a local-first Windows AI workstation with agents, computer use, coding and plugins.",
  "main": "./out/main/index.js",
  "author": "LocalPilot AI",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/toer15/localpilot-ai.git"
  },
  "homepage": "https://github.com/toer15/localpilot-ai#readme",
  "bugs": {
    "url": "https://github.com/toer15/localpilot-ai/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "release:github": "electron-vite build && electron-builder --win nsis portable --publish never && node scripts/publish-release.mjs",
    "selftest": "electron-vite build && electron out/main/index.js --self-test",
    "smoke": "npm run build && node scripts/ui-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "update:check": "node scripts/update-check.mjs",
    "acceptance": "npm run build && node scripts/agent-acceptance.mjs",
    "acceptance:localonly": "npm run build && node scripts/localonly-acceptance.mjs",
    "acceptance:notepad": "npm run build && node scripts/notepad-acceptance.mjs",
    "acceptance:overlay": "npm run build && node scripts/overlay-acceptance.mjs",
    "acceptance:fullscreen": "npm run build && node scripts/fullscreen-acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
